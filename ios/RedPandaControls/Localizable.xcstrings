    "Allow Live Activities for Red Panda to record voice notes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les activités en direct pour Red Panda afin d'enregistrer des notes vocales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Live-Aktivitäten für Red Panda, um Sprachnotizen aufzunehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las Actividades en vivo de Red Panda para grabar notas de voz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti le Attività live per Red Panda per registrare note vocali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボイスメモを録音するには、Red Pandaのライブアクティビティを許可してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالأنشطة المباشرة لـ Red Panda لتسجّل ملاحظات صوتية."
          }
        }
      }
    },

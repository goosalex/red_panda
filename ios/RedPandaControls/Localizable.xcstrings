    "Capture a quick text note with Red Panda.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note rapidement quelque chose avec Red Panda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält schnell eine Textnotiz mit Red Panda fest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota algo rápido con Red Panda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annota al volo una nota di testo con Red Panda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Pandaですばやくテキストメモを残します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل ملاحظة نصّية سريعة مع Red Panda."
          }
        }
      }
    },
    "How the panda feels about your to-dos, and what's due next.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que le panda pense de vos tâches, et la prochaine échéance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie es dem Panda mit deinen Aufgaben geht und was als Nächstes fällig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo se siente el panda con tus pendientes y qué vence pronto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come si sente il panda per le tue attività e cosa scade a breve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ToDoについてのパンダの気分と、次の期限。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شو حاسس الباندا من شغلاتك، وشو اللي موعده قريب."
          }
        }
      }
    },

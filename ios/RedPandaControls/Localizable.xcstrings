    "All done today!": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est fait aujourd'hui !"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute alles erledigt!"

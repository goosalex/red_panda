    "The red panda peeks over your shoulder: %@ is due tomorrow.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le panda jette un œil par-dessus votre épaule : %@ est pour demain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Panda schaut dir über die Schulter: %@ ist morgen fällig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El panda se asoma por tu hombro: %@ vence mañana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il panda sbircia da sopra la tua spalla: %@ scade domani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パンダが肩ごしにのぞいています：%@の期限は明日です。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الباندا عم يتطلّع من فوق كتفك: موعد %@ بكرا."
          }
        }
      }
    },
    "The red panda waited all day for %@. It’s still waiting.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le panda a attendu %@ toute la journée. Il attend toujours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Panda hat den ganzen Tag auf %@ gewartet. Er wartet immer noch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El panda esperó %@ todo el día. Sigue esperando."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il panda ha aspettato %@ tutto il giorno. Sta ancora aspettando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パンダは一日じゅう%@を待っていました。今も待っています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الباندا ضلّ ناطر %@ طول النهار. ولسّا ناطر."
          }
        }
      }
    },
    "Today’s the day! The red panda believes in you: %@ 🐾": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est le grand jour ! Le panda croit en vous : %@ 🐾"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute ist der Tag! Der Panda glaubt an dich: %@ 🐾"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Hoy es el día! El panda cree en ti: %@ 🐾"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il grande giorno! Il panda crede in te: %@ 🐾"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日がその日！パンダはあなたを信じています：%@ 🐾"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اليوم هو اليوم! الباندا مآمن فيك: %@ 🐾"
          }
        }
      }
    },
    "Tomorrow’s the day for %@. The red panda is already a tiny bit nervous 🐾": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demain, c'est le grand jour pour %@. Le panda est déjà un tout petit peu nerveux 🐾"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Morgen ist der Tag für %@. Der Panda ist schon ein klitzekleines bisschen nervös 🐾"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mañana es el día de %@. El panda ya está un poquito nervioso 🐾"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Domani è il giorno di %@. Il panda è già un pochino agitato 🐾"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日は%@の日。パンダはもうちょっぴりドキドキしています 🐾"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بكرا موعد %@. الباندا من هلّق متوتّر شوي 🐾"
          }
        }
      }
    },
    "Two days now. The panda keeps checking for %@ and sighing softly.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà deux jours. Le panda guette %@ et soupire doucement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon zwei Tage. Der Panda hält Ausschau nach %@ und seufzt leise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya van dos días. El panda sigue buscando %@ y suspira bajito."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono già due giorni. Il panda continua a cercare %@ e sospira piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう2日。パンダは%@を何度も確かめては、そっとため息をついています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صرلها يومين. الباندا كل شوي بيتطلّع على %@ وبيتنهّد بهدوء."
          }
        }
      }
    },

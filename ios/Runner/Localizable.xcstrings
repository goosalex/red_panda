{
  "sourceLanguage": "en",
  "strings": {
    "%@ is due today. The panda has stopped chewing its bamboo to watch.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est aujourd'hui pour %@. Le panda a arrêté de mâchouiller son bambou pour surveiller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute ist %@ fällig. Der Panda hat aufgehört, an seinem Bambus zu kauen, um zuzuschauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy vence %@. El panda dejó de masticar su bambú para mirar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi scade %@. Il panda ha smesso di masticare il suo bambù per guardare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日が%@の期限です。パンダは竹をかじるのをやめて見守っています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اليوم موعد %@. الباندا وقّف أكل الخيزران ليتفرّج."
          }
        }
      }
    },
    "%@ slipped past its deadline. The panda’s ears have drooped a little.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'échéance de %@ est passée. Les oreilles du panda tombent un peu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Frist für %@ ist verstrichen. Die Ohren des Pandas hängen ein bisschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pasó la fecha de %@. Al panda se le cayeron un poco las orejitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scadenza di %@ è passata. Le orecchie del panda si sono un po' abbassate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の期限が過ぎてしまいました。パンダの耳が少したれています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راح موعد %@. دينات الباندا نزلوا شوي."
          }
        }
      }
    },
    "A fluffy tail swishes past with a note: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une queue touffue passe avec un petit mot : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein flauschiger Schwanz wedelt mit einem Zettel vorbei: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una colita esponjosa pasa con una nota: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una coda soffice passa di qui con un biglietto: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ふわふわのしっぽがメモを持って通りすぎます：%@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذنب منفوش مرق ومعه ورقة: %@"
          }
        }
      }
    },
    "A small paw taps your screen: %@ is due today.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une petite patte tapote votre écran : %@ est pour aujourd'hui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kleine Pfote tippt auf deinen Bildschirm: %@ ist heute fällig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una patita toca tu pantalla: %@ vence hoy."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una zampetta picchietta sul tuo schermo: %@ scade oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな前足が画面をトントン：%@の期限は今日です。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كفّ زغيرة عم تدقّ على شاشتك: موعد %@ اليوم."
          }
        }
      }
    },
    "A tiny sniffle from the bamboo grove… %@ is overdue 🥺": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit reniflement dans la bambouseraie… %@ est en retard 🥺"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein leises Schniefen aus dem Bambuswald … %@ ist überfällig 🥺"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pequeño sollozo desde el bosque de bambú… ya pasó la fecha de %@ 🥺"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un piccolo singhiozzo dal boschetto di bambù… %@ è in ritardo 🥺"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "竹やぶから小さなすすり泣き… %@の期限が過ぎました 🥺"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شهقة زغيرة من غابة الخيزران… تأخّرنا على %@ 🥺"
          }
        }
      }
    },
    "Allow Live Activities for Red Panda to record voice notes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les activités en direct pour Red Panda afin d'enregistrer des notes vocales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Live-Aktivitäten für Red Panda, um Sprachnotizen aufzunehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las Actividades en vivo de Red Panda para grabar notas de voz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti le Attività live per Red Panda per registrare note vocali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボイスメモを録音するには、Red Pandaのライブアクティビティを許可してください。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالأنشطة المباشرة لـ Red Panda لتسجّل ملاحظات صوتية."
          }
        }
      }
    },
    "Capture a quick text note with Red Panda.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note rapidement quelque chose avec Red Panda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält schnell eine Textnotiz mit Red Panda fest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota algo rápido con Red Panda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annota al volo una nota di testo con Red Panda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Pandaですばやくテキストメモを残します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل ملاحظة نصّية سريعة مع Red Panda."
          }
        }
      }
    },
    "Day three. The panda is sitting by the window, hoping you’ll come back for %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Troisième jour. Le panda est assis près de la fenêtre et espère que vous reviendrez pour %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag drei. Der Panda sitzt am Fenster und hofft, dass du für %@ zurückkommst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Día tres. El panda está sentado junto a la ventana, esperando que vuelvas por %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Terzo giorno. Il panda è seduto alla finestra e spera che tornerai per %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3日目。パンダは窓辺に座って、あなたが%@のために戻ってくるのを待っています。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اليوم التالت. الباندا قاعد حدّ الشبّاك، ناطرك ترجع لـ %@."
          }
        }
      }
    },
    "Heads up from the bamboo grove: %@ is due tomorrow 🎋": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petit message de la bambouseraie : %@ est pour demain 🎋"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine Warnung aus dem Bambuswald: %@ ist morgen fällig 🎋"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso desde el bosque de bambú: %@ vence mañana 🎋"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avviso dal boschetto di bambù: %@ scade domani 🎋"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "竹やぶからのお知らせ：%@の期限は明日です 🎋"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خبرية من غابة الخيزران: موعد %@ بكرا 🎋"
          }
        }
      }
    },
    "It’s awfully quiet without you. The panda has been guarding your list: %lld things are waiting.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "It’s awfully quiet without you. The panda has been guarding your list: %lld thing is waiting."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "It’s awfully quiet without you. The panda has been guarding your list: %lld things are waiting."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "C'est bien calme sans vous. Le panda a gardé votre liste : %lld chose attend."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "C'est bien calme sans vous. Le panda a gardé votre liste : %lld choses attendent."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ohne dich ist es so still. Der Panda hat deine Liste bewacht: %lld Sache wartet."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ohne dich ist es so still. Der Panda hat deine Liste bewacht: %lld Sachen warten."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Está muy callado sin ti. El panda cuidó tu lista: %lld cosa está esperando."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Está muy callado sin ti. El panda cuidó tu lista: %lld cosas están esperando."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "È tutto così silenzioso senza di te. Il panda ha fatto la guardia alla tua lista: %lld cosa ti aspetta."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "È tutto così silenzioso senza di te. Il panda ha fatto la guardia alla tua lista: %lld cose ti aspettano."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "あなたがいないととても静か。パンダがリストを守っています：%lld件が待っています。"
                }
              }
            }
          }
        },
        "ar": {
          "variations": {
            "plural": {
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "الدنيا كتير هادية بلاك. الباندا عم يحرس قائمتك: في %lld شغلة ناطرة."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "الدنيا كتير هادية بلاك. الباندا عم يحرس قائمتك: في شغلة وحدة ناطرة."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "الدنيا كتير هادية بلاك. الباندا عم يحرس قائمتك: في شغلتين ناطرين."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "الدنيا كتير هادية بلاك. الباندا عم يحرس قائمتك: في %lld شغلات ناطرين."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "الدنيا كتير هادية بلاك. الباندا عم يحرس قائمتك: في %lld شغلة ناطرة."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "الدنيا كتير هادية بلاك. الباندا عم يحرس قائمتك: في %lld شغلة ناطرة."
                }
              }
            }
          }
        }
      }
    },

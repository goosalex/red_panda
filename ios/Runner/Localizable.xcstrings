    "Open Red Panda on your leave basket.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Red Panda sur votre panier de départ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Red Panda mit deinem Mitnehm-Korb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Red Panda en tu canasta de salida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Red Panda sul tuo cestino da portare."
          }
        },
        "ja": {

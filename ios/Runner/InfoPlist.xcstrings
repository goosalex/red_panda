          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda reminds you of your leave basket when you leave a place, even while the app is closed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda vous rappelle votre panier de départ quand vous quittez un lieu, même quand l'app est fermée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda erinnert dich an deinen Mitnehm-Korb, wenn du einen Ort verlässt – auch wenn die App geschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda te recuerda tu canasta de salida cuando sales de un lugar, incluso con la app cerrada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda ti ricorda il cestino da portare quando lasci un posto, anche con l'app chiusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Pandaは、アプリを閉じていても、場所を離れるときにお出かけかごをお知らせします。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda بيذكّرك بسلّة الطلعة لما تطلع من محل، حتى لو التطبيق مسكّر."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda remembers where you filled your leave basket, so it can remind you when you leave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda retient où vous avez rempli votre panier de départ, pour vous le rappeler quand vous partez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda merkt sich, wo du deinen Mitnehm-Korb gefüllt hast, damit es dich beim Losgehen erinnern kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda recuerda dónde llenaste tu canasta de salida para avisarte cuando te vayas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda ricorda dove hai riempito il cestino da portare, così può avvisarti quando esci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Pandaはお出かけかごに入れた場所を覚えておき、離れるときにお知らせします。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda بيتذكّر وين عبّيت سلّة الطلعة، لحتى يذكّرك لما تطلع."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda records your voice notes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda enregistre vos notes vocales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda nimmt deine Sprachnotizen auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda graba tus notas de voz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda registra le tue note vocali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Pandaがボイスメモを録音します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda بيسجّل ملاحظاتك الصوتية."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda turns your voice notes into text."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda transforme vos notes vocales en texte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda macht aus deinen Sprachnotizen Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda convierte tus notas de voz en texto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda trasforma le tue note vocali in testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Pandaがボイスメモを文字にします。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Red Panda بيحوّل ملاحظاتك الصوتية لنص."
          }
        }
      }
    }
  },
  "version": "1.0"
}
